{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // The vendored ascii.rest source imports its files by their .ts names.
    "allowImportingTsExtensions": true,
    "paths": { "ascii.rest": ["./vendor/ascii.rest/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
